# Copy to .env for local use. In production set these in the host's environment variables (never commit real values).
DATABASE_URL=sqlite:///./ekatra.db
# Neon: use the POOLED connection string above for the app, and the DIRECT one below for migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-long-random-string
DEMO_PASSWORD=demo
COOKIE_SECURE=false
# DEMO_TODAY=2026-10-23   # optional: freeze the working date for a repeatable demo
